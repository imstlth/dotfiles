[global]
# C'est ça qui faisait le (A)
  show_indicators = false
  follow = mouse
  layer = overlay
  offset = (12, 12)
  padding = 10
  horizontal_padding = 10
  frame_width = 3
  separator_color = "#7AA2F7"
  font = "DejaVu Sans Mono 11"
  markup = full
  format = "<b>%a</b> : <i>%s</i>\n%b"
  word_wrap = true
  mouse_right_click = "context"
  mouse_middle_click = "close_all"
  corner_radius = 10
  progress_bar_corner_radius = 5
  dmenu = rofi -dmenu
  browser = librewolf


# On fait une progress bar stylé
[bar]
  summary = "*"
  highlight = "#B4F9F8, #F7768E"

[urgency_low]
  background = "#16161EAD"
  foreground = "#C0CAF5"
  frame_color = "#7AA2F7CD"

[urgency_normal]
  background = "#1A1B26AD"
  foreground = "#C0CAF5"
  frame_color = "#7AA2F7CD"

[urgency_critical]
  background = "#292E42AD"
  foreground = "#DB4B4B"
  frame_color = "#DB4B4BCD"
