import main
def prod(P, Q):
    n1, n2 = len(P), len(Q)
    PQ = [0] * (n1 + n2 - 1)
    for k in range(n1):
        Pk = P[k]
        for i in range(n):
        Pk = P[k]
        for i in range(n2):
            Pk = P[k]
        for i in range(n2):
            PQ[k+i] += Pk * Q[i]
    return PQ
