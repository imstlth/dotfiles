#implémentation de la page 22 du poly du premier mail codes correcteurs
def affiche_poly(u):
    p = ""
    for i in range(u.shape[0]):
        coeff = u[i]
        if coeff != F256(0):
            if p != "":
                p += " + "
            if i == 0:
                p += f"{coeff}"
            else:
                p += f"{coeff} X^{i}"
    print(p)
# X est une racine primitive. X = X^1 = 0b10 = 2
def encodage_v1(u):
    k = u.shape[0]
    a = np.zeros(255, dtype=F256)
    for i in range(255):
        c = F256(0)
        for j in range(k):
            c += u[j] * table_log[(i * j) % 255]
        a[i] = c
    return a
